---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { projects } from '../../data/site';
---

<Base title="Projects — Divyansh404" description="Security tooling and other things I've built.">
  <Band offset="0000" label="Built">
    <h1 class="display display--caps" style="font-size:clamp(2.25rem,6vw,3.75rem);margin-bottom:1.25rem">
      Projects
    </h1>
    <p class="lede">
      Tools I wrote because I wanted them to exist. Each one came out of a gap I
      hit while testing something.
    </p>
  </Band>

  <Band offset="0010" label="Index">
    <div class="findings">
      {projects.map((p) => (
        <article class="finding">
          <div class="finding__head">
            <h2 class="h3">{p.name}</h2>
            <span class="finding__kind">{p.kind}</span>
          </div>
          <p class="finding__body">{p.blurb}</p>
          <div class="chip-row">
            {p.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
          {p.repo && (
            <p class="link-list" style="margin-top:.25rem">
              <a href={p.repo} target="_blank" rel="noopener">Source →</a>
            </p>
          )}
        </article>
      ))}
    </div>
  </Band>
</Base>
