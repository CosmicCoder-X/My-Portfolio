---
// A section of the report. The rail carries a byte offset — a nod to the
// packet dumps this work actually lives in — plus the section name.
interface Props {
  offset: string;
  label?: string;
  id?: string;
}
const { offset, label, id } = Astro.props;
---

<section class="band" id={id}>
  <div class="band__rail" aria-hidden="true">
    <b>{offset}</b>
    {label && <span>{label}</span>}
  </div>
  <div>
    <slot />
  </div>
</section>
