---
// Client-side behaviour for long-form pages: image lightbox, code
// copy, caption toggles, and table-of-contents scrollspy. All of it is
// additive — the page is fully readable and navigable without any of it.
---

<dialog class="lb" data-lightbox aria-label="Enlarged screenshot">
  <button class="lb__close" data-lb-close type="button">Close · Esc</button>
  <img data-lb-img src="" alt="" />
  <p class="lb__cap" data-lb-cap></p>
</dialog>

<script>
  // View transitions swap the document body without re-evaluating this
  // module, so anything that touches elements has to run again on every
  // navigation. `astro:page-load` fires on the first load and after each
  // transition, which is exactly that hook.
  //
  // Listeners bound to `document` must NOT go inside it, or they stack
  // up one copy per navigation — those are registered once, below.

  const ZOOMABLE = 'article.doc img, .cert-tile__img-wrap img';

  function openLightbox(src: string, alt: string) {
    // Look the dialog up at call time: the previous page's copy is gone.
    const dlg = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    if (!dlg) return;
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]');
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]');
    if (!img || !cap) return;

    img.src = src;
    img.alt = alt;
    cap.textContent = alt;
    cap.hidden = !alt;
    if (typeof dlg.showModal === 'function') dlg.showModal();
  }

  // ── Registered once, for the life of the document ──────────
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;

    if (t.matches?.(ZOOMABLE)) {
      e.preventDefault();
      const el = t as HTMLImageElement;
      openLightbox(el.currentSrc || el.src, el.alt || '');
      return;
    }

    // Certificate tiles are buttons wrapping an image, so they also
    // work from the keyboard.
    const zoomBtn = t.closest?.('[data-zoom]');
    if (zoomBtn) {
      const el = zoomBtn.querySelector('img');
      if (el) openLightbox(el.currentSrc || el.src, el.alt || '');
      return;
    }

    if (t.closest?.('[data-lb-close]')) {
      document.querySelector<HTMLDialogElement>('[data-lightbox]')?.close();
      return;
    }

    // Clicking the backdrop — the dialog itself, not the image — closes.
    if (t.matches?.('[data-lightbox]')) {
      (t as HTMLDialogElement).close();
    }
  });

  document.addEventListener('astro:page-load', () => {
    // ── Long figure captions ─────────────────────────────────
    // The caption is the image's alt text and often runs to a paragraph.
    // Clamp it here rather than in CSS so a reader without JavaScript
    // sees the whole thing instead of two orphaned lines.
    document.querySelectorAll<HTMLElement>('article.doc figure').forEach((fig) => {
      if (fig.dataset.capWired) return;
      fig.dataset.capWired = '1';

      const cap = fig.querySelector<HTMLElement>('figcaption');
      if (!cap) return;

      const full = cap.scrollHeight;
      fig.classList.add('is-clamped');
      if (cap.clientHeight >= full) {
        fig.classList.remove('is-clamped');
        return;
      }

      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'cap-toggle';
      btn.textContent = 'Full caption';
      btn.setAttribute('aria-expanded', 'false');
      btn.addEventListener('click', () => {
        const open = fig.hasAttribute('data-open');
        fig.toggleAttribute('data-open', !open);
        btn.textContent = open ? 'Full caption' : 'Collapse caption';
        btn.setAttribute('aria-expanded', String(!open));
      });
      cap.insertAdjacentElement('afterend', btn);
    });

    // ── Copy buttons on code blocks ──────────────────────────
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      if (btn.dataset.wired) return;
      btn.dataset.wired = '1';

      btn.addEventListener('click', async () => {
        const pre = btn.parentElement?.querySelector('pre');
        const text = pre?.innerText ?? '';
        if (!text) return;

        try {
          await navigator.clipboard.writeText(text);
        } catch {
          // Clipboard API needs a secure context; fall back quietly.
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.style.position = 'fixed';
          ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch { /* give up silently */ }
          ta.remove();
        }

        btn.textContent = 'Copied';
        btn.dataset.done = '1';
        setTimeout(() => {
          btn.textContent = 'Copy';
          delete btn.dataset.done;
        }, 1600);
      });
    });

    // ── Table of contents scrollspy ──────────────────────────
    const toc = document.querySelector<HTMLElement>('[data-toc]');
    if (!toc) return;

    const linkFor = new Map<string, HTMLAnchorElement>();
    toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((a) => {
      linkFor.set(decodeURIComponent(a.getAttribute('href')!.slice(1)), a);
    });

    const headings = [...linkFor.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length === 0) return;

    let current: HTMLAnchorElement | null = null;
    const setActive = (id: string) => {
      const a = linkFor.get(id);
      if (!a || a === current) return;
      current?.classList.remove('is-active');
      a.classList.add('is-active');
      current = a;
    };

    const io = new IntersectionObserver(
      (records) => {
        const visible = records
          .filter((r) => r.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -70% 0px', threshold: 0 },
    );
    headings.forEach((h) => io.observe(h));

    // The observer holds references into a document that is about to be
    // discarded; drop it before the next page swaps in.
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  });
</script>
