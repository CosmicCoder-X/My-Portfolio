---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Base title={`${d.title} — Divyansh404`} description={d.summary}>
  <Band offset="0000" label="Post">
    <a class="back" href="/blog/">← Blog</a>
    <h1 class="display" style="font-size:clamp(1.875rem,5vw,3rem);margin-bottom:1rem">
      {d.title}
    </h1>
    <p class="mono-label" style="margin-bottom:1rem">{fmt(d.date)}</p>
    {d.tags.length > 0 && (
      <div class="chip-row">
        {d.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
    )}
  </Band>

  <Band offset="0010" label="Text">
    <article class="doc">
      <Content />
    </article>
  </Band>
</Base>
