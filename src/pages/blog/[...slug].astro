---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import ArticleUX from '../../components/ArticleUX.astro';
import { getCollection, render } from 'astro:content';
import { person } from '../../data/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return posts.map((entry, i) => ({
    params: { slug: entry.id },
    props: {
      entry,
      newer: i > 0 ? posts[i - 1] : null,
      older: i < posts.length - 1 ? posts[i + 1] : null,
    },
  }));
}

const { entry, newer, older } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const fmt = (date: Date) =>
  date.toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.summary,
  datePublished: d.date.toISOString(),
  author: { '@type': 'Person', name: person.name, url: Astro.site?.toString() },
  keywords: d.tags.join(', '),
  url: new URL(Astro.url.pathname, Astro.site).toString(),
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<Base title={`${d.title} — Divyansh404`} description={d.summary} ogType="article" jsonLd={jsonLd}>
  <Band offset="0000" label="Post">
    <a class="back" href="/blog/">← Blog</a>
    <h1 class="display" style="font-size:clamp(1.875rem,5vw,3rem);margin-bottom:1rem">
      {d.title}
    </h1>
    <p class="lede muted" style="margin-bottom:1rem">{d.summary}</p>
    <p class="mono-label" style="margin-bottom:1rem">{fmt(d.date)}</p>
    {d.tags.length > 0 && (
      <div class="chip-row">
        {d.tags.map((t) => <span class="chip">{t}</span>)}
      </div>
    )}
  </Band>

  <Band offset="0010" label="Text">
    <div class="reading">
      <article class="doc">
        <Content />
      </article>

      {toc.length > 2 && (
        <nav class="toc" data-toc aria-label="On this page">
          <div class="toc__title">On this page</div>
          <ol>
            {toc.map((h) => (
              <li class={`lvl-${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </Band>

  {(newer || older) && (
    <Band offset="0020" label="Continue">
      <div class="pager">
        {newer && (
          <a href={`/blog/${newer.id}/`}>
            <span>← Newer</span>
            <b>{newer.data.title}</b>
          </a>
        )}
        {older && (
          <a class="next" href={`/blog/${older.id}/`}>
            <span>Older →</span>
            <b>{older.data.title}</b>
          </a>
        )}
      </div>
    </Band>
  )}

  <ArticleUX />
</Base>
