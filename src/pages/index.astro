---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import { getCollection } from 'astro:content';
import { person, cover, projects, roles } from '../data/site';

const all = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = all.slice(0, 4);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base>
  <header class="cover" slot="cover">
    <div class="cover__in">
      <div class="cover__rail" aria-hidden="true">
        <b>0000</b>
        <span>Cover</span>
      </div>
      <div>
        <p class="cover__eyebrow rise rise-1">Assessment subject — self</p>

        <h1 class="cover__name rise rise-2">Divyansh<br />Agrawal</h1>

        <p class="cover__lede rise rise-3">
          I break web applications, networks and — increasingly — language
          models, then write the tool that would have caught me.
        </p>

        <table class="meta rise rise-3">
          <tbody>
            {cover.map((row) => (
              <tr>
                <th scope="row">{row.k}</th>
                <td>{row.v}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </header>

  <Band offset="0010" label="Statement">
    <h2 class="h2">In my own words</h2>
    <div class="prose">
      <p>{person.statement}</p>
    </div>
  </Band>

  <Band offset="0020" label="Evidence">
    <h2 class="h2">Recent writeups</h2>
    <p class="muted" style="max-width:36rem;margin-bottom:1.75rem">
      Every room and machine here is written as a case: what the problem was,
      what I did, what came out of it. Not a list of commands.
    </p>

    {latest.length === 0 ? (
      <p class="muted">
        No writeups published yet. Drop a markdown file into
        <code style="font-family:var(--font-mono);font-size:.85em"> src/content/writeups/ </code>
        and it appears here.
      </p>
    ) : (
      <div class="entries">
        {latest.map((w) => (
          <a class="entry" href={`/writeups/${w.id}/`}>
            <span class="entry__title">{w.data.title}</span>
            <span class="entry__meta">
              {roles[w.data.role]} · {fmt(w.data.date)}
            </span>
            <span class="entry__sum">{w.data.summary}</span>
          </a>
        ))}
      </div>
    )}

    <p style="margin-top:1.5rem">
      <a class="go" href="/writeups/">All writeups →</a>
    </p>
  </Band>

  <Band offset="0030" label="Built">
    <h2 class="h2">Things I've built</h2>
    <div class="findings">
      {projects.slice(0, 3).map((p) => (
        <article class="finding">
          <div class="finding__head">
            <h3 class="h3">{p.name}</h3>
            <span class="finding__kind">{p.kind}</span>
          </div>
          <p class="finding__body">{p.blurb}</p>
          <div class="chip-row">
            {p.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
        </article>
      ))}
    </div>

    <p style="margin-top:1.5rem">
      <a class="go" href="/projects/">All projects →</a>
    </p>
  </Band>

  <Band offset="0040" label="Contact">
    <h2 class="h2">Get in touch</h2>
    <p class="prose" style="margin-bottom:1.25rem">
      I'm looking for security engineering and penetration testing work. If
      you've got something you'd like tested, or a team that needs someone who
      writes their own tooling, mail is the fastest way to reach me.
    </p>
    <p class="link-list">
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </p>
  </Band>
</Base>
