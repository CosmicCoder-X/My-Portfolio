---
import Base from '../layouts/Base.astro';
import Band from '../components/Band.astro';
import EvidenceGrid from '../components/EvidenceGrid.astro';
import { getCollection } from 'astro:content';
import { person, cover, projects, roles, platforms } from '../data/site';
import { capabilityCounts, tagCounts } from '../lib/evidence';

const all = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = all.slice(0, 5);

const caps = capabilityCounts(all).slice(0, 6);

const activePlatforms = platforms.filter((p) =>
  all.some((w) => w.id.split('/')[0] === p.slug),
).length;

const disciplines = new Set(all.map((w) => w.data.role)).size;
const harder = all.filter(
  (w) => w.data.difficulty === 'hard' || w.data.difficulty === 'insane',
).length;
// Tags used in two or more writeups. The raw distinct-tag count is
// ~740, but most of that tail is one-off CVE ids — quoting it would
// read as padding on a row whose whole job is credibility.
const techniques = tagCounts(all, 2).length;

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
---

<Base>
  <header class="cover" slot="cover">
    <div>
      <div class={`cover__split${person.portrait ? ' has-portrait' : ''}`}>
        <div>
          <h1 class="cover__name rise rise-1">Divyansh Agrawal</h1>

          <p class="cover__lede rise rise-2">
            Cybersecurity engineer by day and vigilante hacker by night.
          </p>

          <div class="btn-row rise rise-3">
            <a class="btn" href="/resume/">Résumé</a>
            <a class="btn-icon" href="https://github.com/CosmicCoder-X" target="_blank" rel="me noopener" aria-label="GitHub">
              <svg viewBox="0 0 16 16" width="18" height="18" fill="currentColor" aria-hidden="true">
                <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z" />
              </svg>
            </a>
            <a class="btn-icon" href="https://linkedin.com/in/divyansh-agrawal1337" target="_blank" rel="me noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
              </svg>
            </a>
          </div>
        </div>

        {person.portrait && (
          <div class="portrait rise rise-3">
            <span class="cover__tick" aria-hidden="true"></span>
            <img
              src={person.portrait}
              alt={person.portraitAlt}
              width="1264"
              height="842"
              fetchpriority="high"
            />
          </div>
        )}
      </div>

      <!-- Bio sits directly under the hero, unlabeled, the way it reads on
           the reference site — not tucked into a separate "Statement"
           section further down the page. -->
      <div class="prose cover__bio rise rise-4">
        {person.statement.split(/\n\s*\n/).map((para) => (
          <p>{para.replace(/\s+/g, ' ').trim()}</p>
        ))}
      </div>

      <table class="meta rise rise-4" style="margin-top:1.5rem">
        <tbody>
          {cover.map((row) => (
            <tr>
              <th scope="row">{row.k}</th>
              <td>{row.v}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- The thesis: every square is a documented engagement. -->
      <div class="rise rise-4" style="margin-top:clamp(2.25rem,5vw,3.5rem)">
        <EvidenceGrid items={all} />
      </div>
    </div>
  </header>

  <Band label="By the numbers">
    {/* Four, not five. The grid resolves to 4, 2 or 1 columns as the
        viewport narrows, and four items fill every one of those —
        five left a dead cell stranded on mobile. Platform count is
        dropped rather than padded; it is on the writeups page. */}
    <div class="stats">
      <div class="stat">
        <span class="stat__num">{all.length}</span>
        <span class="stat__label">Published writeups</span>
      </div>
      <div class="stat">
        <span class="stat__num">{disciplines}</span>
        <span class="stat__label">Security disciplines</span>
      </div>
      <div class="stat">
        <span class="stat__num">{harder}</span>
        <span class="stat__label">Hard / insane rated</span>
      </div>
      <div class="stat">
        <span class="stat__num">{techniques}</span>
        <span class="stat__label">Recurring techniques</span>
      </div>
    </div>
    <p class="muted" style="margin-top:1rem;font-size:.9375rem;max-width:40rem">
      Every number in this row is counted from the writeups themselves at
      build time. Nothing here is a rounded-up claim.
    </p>
  </Band>

  <Band label="Capability">
    <h2 class="h2">What I can actually do</h2>
    <p class="muted" style="max-width:38rem;margin-bottom:1.75rem">
      Not a skills list. Each line links through to the writeups that prove it.
    </p>

    <div class="matrix">
      {caps.map((c) => (
        <a class="cap" href={`/skills/${c.slug}/`}>
          <span class="cap__name">{c.name}</span>
          <span class="cap__n">{c.count} <span>writeups</span></span>
          <span class="cap__bar"><i style={`width:${c.pct}%`}></i></span>
        </a>
      ))}
    </div>

    <p style="margin-top:1.5rem">
      <a class="go" href="/skills/">Full capability index →</a>
    </p>
  </Band>

  <Band label="Recent work">
    <h2 class="h2">Latest writeups</h2>
    <p class="muted" style="max-width:36rem;margin-bottom:1.75rem">
      Every room and machine here is written as a case: what the problem was,
      what I did, what came out of it. Not a list of commands.
    </p>

    {latest.length === 0 ? (
      <p class="muted">No writeups published yet.</p>
    ) : (
      <div class="entries">
        {latest.map((w) => (
          <a class="entry" href={`/writeups/${w.id}/`}>
            <span class="entry__title">{w.data.title}</span>
            <span class="entry__meta">
              <span class={`chip chip--sev chip--${w.data.difficulty}`}>{w.data.difficulty}</span>
              <span>{roles[w.data.role]}</span>
              <span>{fmt(w.data.date)}</span>
            </span>
            <span class="entry__sum">{w.data.summary}</span>
          </a>
        ))}
      </div>
    )}

    <p style="margin-top:1.5rem">
      <a class="go" href="/writeups/">All {all.length} writeups →</a>
    </p>
  </Band>

  <Band label="Built">
    <h2 class="h2">Things I've built</h2>
    <p class="muted" style="max-width:38rem;margin-bottom:0.5rem">
      Each one came out of a gap I hit while testing something.
    </p>
    <div class="findings">
      {projects.slice(0, 3).map((p) => (
        <article class="finding">
          <div class="finding__head">
            <h3 class="h3">{p.name}</h3>
            <span class="finding__kind">{p.kind}</span>
          </div>
          <p class="finding__body">{p.blurb}</p>
          <div class="chip-row">
            {p.stack.map((s) => <span class="chip">{s}</span>)}
          </div>
          {p.repo && (
            <p class="link-list" style="margin-top:.25rem">
              <a href={p.repo} target="_blank" rel="noopener">Source →</a>
            </p>
          )}
        </article>
      ))}
    </div>

    <p style="margin-top:1.5rem">
      <a class="go" href="/projects/">All projects →</a>
    </p>
  </Band>

  <Band label="Contact">
    <h2 class="h2">Get in touch</h2>
    <div class="prose" style="margin-bottom:1.5rem">
      <p>
        I'm looking for security engineering and penetration testing work in
        India or abroad. If you've got something you'd like tested, or a team
        that needs someone who writes their own tooling, mail is the fastest
        way to reach me.
      </p>
    </div>
    <div class="btn-row">
      <a class="btn" href={`mailto:${person.email}`}>{person.email}</a>
      <a class="btn btn--ghost" href="/resume/">Résumé</a>
    </div>
  </Band>
</Base>
