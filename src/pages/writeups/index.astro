---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { getCollection } from 'astro:content';
import { platforms } from '../../data/site';

const all = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const countFor = (slug: string) =>
  all.filter((w) => w.id.split('/')[0] === slug).length;

const latestFor = (slug: string) => {
  const items = all.filter((w) => w.id.split('/')[0] === slug);
  return items.length > 0 ? items[0] : null;
};

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const difficultySpread = (slug: string) => {
  const items = all.filter((w) => w.id.split('/')[0] === slug);
  const counts: Record<string, number> = {};
  items.forEach((w) => {
    counts[w.data.difficulty] = (counts[w.data.difficulty] || 0) + 1;
  });
  return counts;
};
---

<Base title="Writeups — Divyansh404" description="Penetration testing and CTF writeups, written as case studies.">
  <Band offset="0000" label="Index">
    <h1 class="display display--caps" style="font-size:clamp(2.25rem,6vw,3.75rem);margin-bottom:1.25rem">
      Writeups
    </h1>
    <p class="lede">
      Rooms, machines and challenges, each written the way a finding gets
      written up: the problem, the action, the outcome. Pick a platform to browse.
    </p>
  </Band>

  <Band offset="0010" label="Platforms">
    <div class="platform-grid">
      {platforms.map((p) => {
        const count = countFor(p.slug);
        const latest = latestFor(p.slug);
        const spread = difficultySpread(p.slug);
        return (
          <a class="platform-card" href={`/writeups/${p.slug}/`}>
            <div class="platform-card__head">
              <h2 class="platform-card__name">{p.name}</h2>
              <span class="platform-card__count">{count}</span>
            </div>
            <p class="platform-card__blurb">{p.blurb}</p>
            {count > 0 && (
              <div class="platform-card__meta">
                <div class="platform-card__spread">
                  {Object.entries(spread).map(([diff, n]) => (
                    <span class={`chip chip--sev chip--${diff}`}>{diff} {n}</span>
                  ))}
                </div>
                {latest && (
                  <div class="platform-card__latest">
                    Latest: <strong>{latest.data.title}</strong> — {fmt(latest.data.date)}
                  </div>
                )}
              </div>
            )}
            {count === 0 && (
              <p class="platform-card__empty">Nothing published here yet.</p>
            )}
            <span class="platform-card__arrow">View all →</span>
          </a>
        );
      })}
    </div>
  </Band>

  <Band offset="0020" label="Stats">
    <div class="writeup-stats">
      <div class="stat">
        <span class="stat__num">{all.length}</span>
        <span class="stat__label">Total writeups</span>
      </div>
      <div class="stat">
        <span class="stat__num">{platforms.filter((p) => countFor(p.slug) > 0).length}</span>
        <span class="stat__label">Active platforms</span>
      </div>
      <div class="stat">
        <span class="stat__num">{all.filter((w) => w.data.difficulty === 'hard' || w.data.difficulty === 'insane').length}</span>
        <span class="stat__label">Hard / Insane</span>
      </div>
    </div>
  </Band>
</Base>
