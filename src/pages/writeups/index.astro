---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { getCollection } from 'astro:content';
import { platforms, roles } from '../../data/site';

const all = (await getCollection('writeups', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const countFor = (slug: string) =>
  all.filter((w) => w.id.split('/')[0] === slug).length;

const offsets = ['0000', '0010', '0020', '0030', '0040', '0050'];
---

<Base title="Writeups — Divyansh404" description="Penetration testing and CTF writeups, written as case studies.">
  <Band offset="0000" label="Index">
    <h1 class="display display--caps" style="font-size:clamp(2.25rem,6vw,3.75rem);margin-bottom:1.25rem">
      Writeups
    </h1>
    <p class="lede">
      Rooms, machines and challenges, each written the way a finding gets
      written up: the problem, the action, the outcome. Nothing here contains
      live flags or unsanitised client data.
    </p>
  </Band>

  {platforms.map((p, i) => {
    const items = all.filter((w) => w.id.split('/')[0] === p.slug);
    return (
      <Band offset={offsets[i + 1]} label={p.name}>
        <div style="display:flex;align-items:baseline;gap:1rem;flex-wrap:wrap;margin-bottom:.5rem">
          <h2 class="h2" style="margin-bottom:0">
            <a href={`/writeups/${p.slug}/`} style="text-decoration:none">{p.name}</a>
          </h2>
          <span class="mono-label">{countFor(p.slug)} entries</span>
        </div>
        <p class="muted" style="margin-bottom:1.5rem">{p.blurb}</p>

        {items.length === 0 ? (
          <p class="muted" style="font-size:.9375rem">
            Nothing published here yet.
          </p>
        ) : (
          <div class="entries">
            {items.map((w) => (
              <a class="entry" href={`/writeups/${w.id}/`}>
                <span class="entry__title">{w.data.title}</span>
                <span class="entry__meta">
                  <span class={`chip chip--sev chip--${w.data.difficulty}`}>
                    {w.data.difficulty}
                  </span>
                  &nbsp;{fmt(w.data.date)}
                </span>
                <span class="entry__sum">{w.data.summary}</span>
              </a>
            ))}
          </div>
        )}
      </Band>
    );
  })}
</Base>
