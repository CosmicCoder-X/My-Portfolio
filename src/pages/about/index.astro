---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { getCollection } from 'astro:content';
import { person, credentials, toolkit, links, education, experience } from '../../data/site';
import { capabilityCounts } from '../../lib/evidence';

const all = await getCollection('writeups', ({ data }) => !data.draft);
const top = capabilityCounts(all).slice(0, 4);
---

<Base
  title="About — Divyansh404"
  description="Who I am, what I've studied, and what I can do — with the work to back it."
>
  <Band offset="0000" label="Subject">
    <h1 class="page-title">About</h1>
    <div class="prose lede">
      <p>{person.statement}</p>
    </div>
    <div class="btn-row" style="margin-top:1.75rem">
      <a class="btn" href="/resume/">Résumé</a>
      <a class="btn btn--ghost" href="/skills/">Capability index</a>
    </div>
  </Band>

  <Band offset="0010" label="Background">
    <h2 class="h2">Where I come from</h2>
    <div class="prose">
      <p>
        I'm reading Chemical Engineering at MNNIT Allahabad, class of 2027. It's
        not the obvious route into this field and I've stopped pretending it is.
        What it did give me is process thinking — you learn to look at a system
        as a chain of dependencies where the failure is rarely where the alarm
        goes off.
      </p>
      <p>
        In 2025 I interned at PPGCL Bara, studying the control logic that drives
        physical plant: valves, pumps, filtration. Watching a command travel from
        a screen to a piece of industrial hardware is the clearest lesson in why
        OT security matters that I could have asked for.
      </p>
      <p>
        Outside coursework I coordinate the university's Cybersecurity Club,
        where I run workshops and mentor members through CTF strategy, and I've
        mentored project teams across robotics, aeromodelling and astronomy.
      </p>
    </div>
  </Band>

  <Band offset="0020" label="Strengths">
    <h2 class="h2">Where the depth is</h2>
    <p class="muted" style="max-width:38rem;margin-bottom:1.5rem">
      Counted from {all.length} published writeups rather than asserted.
    </p>
    <div class="matrix">
      {top.map((c) => (
        <a class="cap" href={`/skills/${c.slug}/`}>
          <span class="cap__name">{c.name}</span>
          <span class="cap__n">{c.count} <span>writeups</span></span>
          <span class="cap__bar"><i style={`width:${c.pct}%`}></i></span>
        </a>
      ))}
    </div>
    <p style="margin-top:1.5rem">
      <a class="go" href="/skills/">Full index →</a>
    </p>
  </Band>

  <Band offset="0030" label="Experience">
    <h2 class="h2">Roles</h2>
    <div class="findings">
      {experience.map((e) => (
        <article class="finding">
          <div class="finding__head">
            <h3 class="h3">{e.role}</h3>
            <span class="finding__kind">{e.org}</span>
            <span class="mono-label" style="margin-left:auto">{e.period}</span>
          </div>
          <ul class="finding__points">
            {e.points.map((pt) => <li>{pt}</li>)}
          </ul>
        </article>
      ))}
      {education.map((e) => (
        <article class="finding">
          <div class="finding__head">
            <h3 class="h3">{e.qualification}</h3>
            <span class="finding__kind">{e.school}</span>
            <span class="mono-label" style="margin-left:auto">{e.period}</span>
          </div>
          <p class="finding__body">{e.detail}</p>
        </article>
      ))}
    </div>
  </Band>

  <Band offset="0040" label="Credentials">
    <h2 class="h2">Certifications and study</h2>
    <div class="entries">
      {credentials.map((c) => (
        <div class="entry" style="cursor:default">
          <span class="entry__title">{c.name}</span>
          <span class="entry__meta">{c.kind}</span>
          <span class="entry__sum">{c.issuer}</span>
        </div>
      ))}
    </div>
    <p style="margin-top:1.25rem">
      <a class="go" href="/certifications/">Competition certificates →</a>
    </p>
  </Band>

  <Band offset="0050" label="Toolkit">
    <h2 class="h2">What I work with</h2>
    {toolkit.map((g) => (
      <div class="tool-group">
        <h4>{g.group}</h4>
        <div class="chip-row">
          {g.items.map((i) => <span class="chip">{i}</span>)}
        </div>
      </div>
    ))}
  </Band>

  <Band offset="0060" label="Elsewhere">
    <h2 class="h2">Find me</h2>
    <p class="link-list" style="margin-bottom:1.5rem">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="me noopener">{l.label}</a>
      ))}
    </p>
    <div class="btn-row">
      <a class="btn" href={`mailto:${person.email}`}>{person.email}</a>
    </div>
  </Band>
</Base>
