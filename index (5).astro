---
import Base from '../../layouts/Base.astro';
import Band from '../../components/Band.astro';
import { person, credentials, toolkit, links } from '../../data/site';
---

<Base title="About — Divyansh404" description="Who I am, what I've studied, and what I can do.">
  <Band offset="0000" label="Subject">
    <h1 class="display display--caps" style="font-size:clamp(2.25rem,6vw,3.75rem);margin-bottom:1.5rem">
      About
    </h1>
    <div class="prose lede">
      <p>{person.statement}</p>
    </div>
  </Band>

  <Band offset="0010" label="Background">
    <h2 class="h2">Where I come from</h2>
    <div class="prose">
      <p>
        I'm reading Chemical Engineering at MNNIT Allahabad, class of 2027. It's
        not the obvious route into this field and I've stopped pretending it is.
        What it did give me is process thinking — you learn to look at a system
        as a chain of dependencies where the failure is rarely where the alarm
        goes off.
      </p>
      <p>
        In 2025 I interned at PPGCL Bara, studying the control logic that drives
        physical plant: valves, pumps, filtration. Watching a command travel from
        a screen to a piece of industrial hardware is the clearest lesson in why
        OT security matters that I could have asked for.
      </p>
      <p>
        Outside coursework I coordinate the university's Cybersecurity Club,
        where I run workshops and mentor members through CTF strategy, and I've
        mentored project teams across robotics, aeromodelling and astronomy.
      </p>
    </div>
  </Band>

  <Band offset="0020" label="Credentials">
    <h2 class="h2">Certifications and study</h2>
    <div class="entries">
      {credentials.map((c) => (
        <div class="entry" style="cursor:default">
          <span class="entry__title">{c.name}</span>
          <span class="entry__meta">{c.kind}</span>
          <span class="entry__sum">{c.issuer}</span>
        </div>
      ))}
    </div>
  </Band>

  <Band offset="0030" label="Toolkit">
    <h2 class="h2">What I work with</h2>
    {toolkit.map((g) => (
      <div class="tool-group">
        <h4>{g.group}</h4>
        <div class="chip-row">
          {g.items.map((i) => <span class="chip">{i}</span>)}
        </div>
      </div>
    ))}
  </Band>

  <Band offset="0040" label="Elsewhere">
    <h2 class="h2">Find me</h2>
    <p class="link-list" style="margin-bottom:1.25rem">
      {links.map((l) => (
        <a href={l.url} target="_blank" rel="me noopener">{l.label}</a>
      ))}
    </p>
    <p class="link-list">
      <a href={`mailto:${person.email}`}>{person.email}</a>
    </p>
  </Band>
</Base>
